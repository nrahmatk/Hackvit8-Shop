<%- include('../partials/header', { title: 'Login Page' }) %>
<%- include('../partials/navbar', { role }) %>

<div class="container mt-5">
  <h1 class="mb-4 text-center">Edit Order</h1>
  
  <!-- Product Form -->
  <form action="/admin/<%= data.id %>/editOrder" method="post">
    <div class="form-group">
      <label for="name">UserId</label>
      <input type="text" class="form-control" name="UserId" placeholder="Enter product name" value="<%= data.UserId %>" required>
    </div>
    <div class="form-group">
      <label for="name">Order Status</label>
      <input type="text" class="form-control" name="orderStatus" placeholder="Enter product name" value="<%= data.orderStatus %>" required>
    </div>
    <div class="form-group">
      <label for="name">Total Amount</label>
      <input type="text" class="form-control" name="totalAmount" placeholder="Enter product name" value="<%= data.totalAmount %>" required>
    </div>
    <div class="text-center">
      <button type="submit" class="btn btn-primary">Submit</button>
    </div>
  </form>
</div>

  <%- include('../partials/footer') %>
